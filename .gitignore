.claude/settings.local.json
.DS_Store
.idea/
.vscode/

# Account register holds IBANs / account numbers.
config/accounts.yaml
# Passwort-Hash und Sitzungsgeheimnis, dazu host: 0.0.0.0. Eingecheckt fiel die
# lokale Einstellung auf den Stand im Repository zurueck, und der Server war
# ploetzlich nur noch lokal erreichbar. Das Backup enthaelt die Datei weiter.
config/server.yaml
overrides.yaml.lock
